@inject IJSRuntime JSRuntime

<div class="top-row ps-1 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RandomizerTools</a>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm theme-toggle" @onclick="ToggleThemeMode">
                @if (currentTheme == "light")
                {
                    <span>Light</span>
                }
                else
                {
                    <span>Dark</span>
                }
            </button>
            <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-3" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="wheel">
                <span class="bi bi-pie-chart-fill me-3" aria-hidden="true"></span> Wheel of Names
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="coin">
                <span class="bi bi-circle-half me-3" aria-hidden="true"></span> Coin Flip
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="dice">
                <span class="bi bi-dice-6-fill me-3" aria-hidden="true"></span> Dice Roller
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="number">
                <span class="bi bi-123 me-3" aria-hidden="true"></span> Number Generator
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="teams">
                <span class="bi bi-people-fill me-3" aria-hidden="true"></span> Team Generator
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="shuffle">
                <span class="bi bi-shuffle me-3" aria-hidden="true"></span> List Shuffler
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="password">
                <span class="bi bi-key-fill me-3" aria-hidden="true"></span> Password Generator
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="8ball">
                <span class="bi bi-magic me-3" aria-hidden="true"></span> Magic 8 Ball
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center" href="datetime">
                <span class="bi bi-calendar2-check me-3" aria-hidden="true"></span> Date & Time Picker
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string currentTheme = "dark";

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Toggles nav expansion
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Initialize persisted or system theme
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                currentTheme = await JSRuntime.InvokeAsync<string>("themeHelper.init");
            }
            catch
            {
                currentTheme = "dark";
            }
            StateHasChanged();
        }
    }

    // Switches between light/dark theme
    private async Task ToggleThemeMode()
    {
        try
        {
            currentTheme = await JSRuntime.InvokeAsync<string>("themeHelper.toggle");
        }
        catch
        {
            currentTheme = currentTheme == "light" ? "dark" : "light";
        }
        StateHasChanged();
    }
}
