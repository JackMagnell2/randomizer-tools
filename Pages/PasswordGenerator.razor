@page "/password"
@using RandomizerTools.ViewModels
@using RandomizerTools.Services
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime

<PageTitle>Password Generator - RandomizerTools</PageTitle>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-white" style="font-family: 'Fredoka', sans-serif;">Password Generator</h1>
        <p class="text-white-50 mb-0">Secure 16-character passwords with one tap</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
            <div class="card glass-card p-4 mb-3">
                <div class="d-flex align-items-center gap-2 password-display flex-wrap">
                    <input class="form-control password-input flex-grow-1" type="@InputType" value="@_viewModel.CurrentPassword" @oninput="OnPasswordInput" placeholder="Generated password" />
                    <button class="btn btn-outline-light btn-sm" @onclick="ToggleMask">@MaskLabel</button>
                    <button class="btn btn-outline-light btn-sm" @onclick="CopyPassword" disabled="@string.IsNullOrEmpty(_viewModel.CurrentPassword)">Copy</button>
                </div>

                <div class="strength-bar mt-3">
                    <div class="strength-fill @StrengthClass" style="width: @_viewModel.StrengthScore%"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2 small text-white-50">
                    <span>Strength</span>
                    <span>@_viewModel.StrengthLabel (@_viewModel.StrengthScore)%</span>
                </div>

                <button class="btn spin-btn w-100 mt-4" @onclick="GeneratePassword">
                    Generate New Password
                </button>
            </div>

            <div class="card glass-card p-4">
                <h5 class="text-white mb-3">Character Sets</h5>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="upperSwitch" @bind="_viewModel.UseUpper" @bind:after="OnOptionsChanged">
                            <label class="form-check-label text-white" for="upperSwitch">Uppercase</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="lowerSwitch" @bind="_viewModel.UseLower" @bind:after="OnOptionsChanged">
                            <label class="form-check-label text-white" for="lowerSwitch">Lowercase</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="digitSwitch" @bind="_viewModel.UseDigits" @bind:after="OnOptionsChanged">
                            <label class="form-check-label text-white" for="digitSwitch">Digits</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="symbolSwitch" @bind="_viewModel.UseSymbols" @bind:after="OnOptionsChanged">
                            <label class="form-check-label text-white" for="symbolSwitch">Symbols</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3 text-white-50 small">Length: 16 characters (fixed)</div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card glass-card p-4 info-card">
                <h5 class="text-white mb-3">Tips</h5>
                <ul class="text-white-50 small mb-0">
                    <li>Keep all sets enabled for strongest results.</li>
                    <li>Click copy to use instantly; generation is all local.</li>
                    <li>No data leaves your browser.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private PasswordGeneratorViewModel _viewModel = null!;

    protected override void OnInitialized()
    {
        _viewModel = new PasswordGeneratorViewModel(RandomizerService);
        GeneratePassword();
    }

    private async Task CopyPassword()
    {
        if (string.IsNullOrEmpty(_viewModel.CurrentPassword)) return;
        await JSRuntime.InvokeVoidAsync("passwordHelper.copy", _viewModel.CurrentPassword);
    }

    private void GeneratePassword()
    {
        _viewModel.Generate();
    }

    private string StrengthClass => _viewModel.StrengthLabel switch
    {
        "Strong" => "strength-strong",
        "Medium" => "strength-medium",
        _ => "strength-weak"
    };

    private bool showPassword = true;
    private string InputType => showPassword ? "text" : "password";
    private string MaskLabel => showPassword ? "Hide" : "Show";

    private void ToggleMask()
    {
        showPassword = !showPassword;
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        _viewModel.UpdatePassword(value);
    }

    private void OnOptionsChanged()
    {
        _viewModel.RefreshStrengthFromOptions();
    }
}
