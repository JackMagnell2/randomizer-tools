@page "/shuffle"
@using RandomizerTools.ViewModels
@using RandomizerTools.Services
@using System.Text.Json
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>List Shuffler - RandomizerTools</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-white mb-2" style="font-family: 'Fredoka', sans-serif;">List Shuffler</h1>
        <p class="text-white-50">Randomize the order of any list!</p>
    </div>

    <div class="row g-4">
        
        <div class="col-lg-4">
            <div class="card entries-card h-100">
                <div class="card-header border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold mb-0 text-white">Items</h3>
                    <small class="text-white-50">@_viewModel.Items.Count items</small>
                </div>
                <div class="card-body d-flex flex-column">
                    
                    <div class="input-group modern-input-group mb-3">
                        <input type="text" class="form-control modern-input" 
                               placeholder="Add items..." 
                               @bind="currentInput" 
                               @onkeyup="HandleKeyUp" />
                        <button class="btn btn-add" @onclick="AddEntry">ADD</button>
                    </div>
                    
                    <div class="entries-list flex-grow-1 overflow-auto pe-2" style="max-height: 50vh;">
                        @if (_viewModel.Items.Count == 0)
                        {
                            <div class="text-center text-white-50 mt-5">
                                <span class="fs-1">📝</span>
                                <p class="mt-2 small">Add items to shuffle.<br>Tip: Separate with commas!</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in _viewModel.Items.ToList()) 
                            {
                                <div class="entry-item">
                                    <span class="entry-text text-truncate">@item</span>
                                    <button class="btn btn-link btn-remove-entry p-0 text-decoration-none" @onclick="() => RemoveEntry(item)">✕</button>
                                </div>
                            }
                        }
                    </div>
                    
                    @if (_viewModel.Items.Count > 0)
                    {
                        <div class="mt-3">
                            <button class="btn btn-outline-light btn-sm w-100" @onclick="ClearAll">Clear List</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            
            <div class="settings-card mb-4 text-center">
                <div class="mb-4">
                    <span class="fs-1">🔀</span>
                </div>
                <button class="btn spin-btn" @onclick="Shuffle" disabled="@isShuffling">
                    @if(isShuffling) { <span>Shuffling...</span> } else { <span>SHUFFLE LIST</span> }
                </button>
            </div>

            <div class="results-container">
                @if (_viewModel.ShuffledResult.Count > 0 && !isShuffling)
                {
                    <div class="result-card">
                        <div class="result-header">
                            NEW ORDER
                        </div>
                        <div class="result-body">
                            @for (int i = 0; i < _viewModel.ShuffledResult.Count; i++)
                            {
                                var item = _viewModel.ShuffledResult[i];
                                var index = i + 1;
                                <div class="result-item fade-in-left" style="animation-delay: @(i * 0.05)s">
                                    <span class="index-badge">@index</span>
                                    <span class="item-text">@item</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (!isShuffling)
                {
                    <div class="text-center text-white-50 mt-5">
                        <i>Ready to shuffle...</i>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code {
    private ListShufflerViewModel _viewModel = null!;
    private string currentInput = "";
    private bool isShuffling = false;
    private DotNetObjectReference<ListShuffler>? objRef;
    private const string LocalStorageKey = "shuffler_state";

    // Initialize View Model
    protected override void OnInitialized()
    {
        _viewModel = new ListShufflerViewModel(RandomizerService);
        objRef = DotNetObjectReference.Create(this);
    }

    // Load state and JS
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadState();
            try { await JSRuntime.InvokeVoidAsync("shufflerHelper.init", objRef); } catch { }
            StateHasChanged();
        }
    }

    // Adds item to list
    private async Task AddEntry()
    {
        if (!string.IsNullOrWhiteSpace(currentInput))
        {
            _viewModel.AddItem(currentInput);
            currentInput = "";
            await SaveState();
        }
    }

    // Removes item from list
    private async Task RemoveEntry(string item)
    {
        _viewModel.RemoveItem(item);
        await SaveState();
    }

    // Clears all data
    private async Task ClearAll()
    {
        _viewModel.Clear();
        await SaveState();
    }

    // Handle enter key
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddEntry();
    }

    // Execute shuffle logic
    private async Task Shuffle()
    {
        if (isShuffling || _viewModel.Items.Count < 2) return;
        
        isShuffling = true;
        
        try { await JSRuntime.InvokeVoidAsync("shufflerHelper.playShuffle"); } catch { }
        
        await Task.Delay(600);

        _viewModel.Shuffle();
        
        try { await JSRuntime.InvokeVoidAsync("shufflerHelper.playWin"); } catch { }

        isShuffling = false;
        await SaveState();
    }

    // Save to local storage
    private async Task SaveState()
    {
        var data = new { Items = _viewModel.Items, Result = _viewModel.ShuffledResult };
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, JsonSerializer.Serialize(data));
    }

    // Load from local storage
    private async Task LoadState()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", LocalStorageKey);
        if (!string.IsNullOrEmpty(json))
        {
            try {
                var data = JsonSerializer.Deserialize<SavedShufflerState>(json);
                if (data != null) _viewModel.RestoreState(data.Items, data.Result);
            } catch {}
        }
    }

    public ValueTask DisposeAsync()
    {
        objRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    // Persistence DTO
    class SavedShufflerState 
    { 
        public List<string>? Items { get; set; } 
        public List<string>? Result { get; set; } 
    }
}
