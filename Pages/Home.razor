@page "/"

<PageTitle>RandomizerTools - Fast & Simple Randomizer Tools</PageTitle>

<div class="home-header">
    <h1 class="site-title">RandomizerTools</h1>
    <p class="site-subtitle">Fast, simple, and free randomizer tools for everyday use</p>
</div>

<!-- Tools Grid -->
<div class="tools-container">
    
    <a href="/wheel" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🎡</span>
            <h3>Wheel of Names</h3>
            <p>Randomly select from a list of names</p>
        </div>
    </a>

    <a href="/coin" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🪙</span>
            <h3>Coin Flip</h3>
            <p>Simple heads or tails decision maker</p>
        </div>
    </a>

    <a href="/dice" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🎲</span>
            <h3>Dice Roller</h3>
            <p>Roll dice with any number of sides</p>
        </div>
    </a>

    <a href="/number" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🔢</span>
            <h3>Number Generator</h3>
            <p>Generate random numbers in any range</p>
        </div>
    </a>

    <a href="/teams" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">👥</span>
            <h3>Team Generator</h3>
            <p>Split lists into balanced random teams</p>
        </div>
    </a>

    <a href="/shuffle" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🔀</span>
            <h3>List Shuffler</h3>
            <p>Randomly shuffle any list of items</p>
        </div>
    </a>

</div>