@page "/"

<PageTitle>RandomizerKit - Fast & Simple Randomizer Tools</PageTitle>

<div class="home-header">
    <h1 class="site-title">RandomizerKit</h1>
    <p class="site-subtitle">Fast, simple, and free randomizer tools for everyday use</p>
</div>

<!-- Tools Grid -->
<div class="tools-container">
    
    <a href="/wheel" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🎡</span>
            <h3>Wheel of Names</h3>
            <p>Randomly select from a list of names</p>
        </div>
    </a>

    <a href="/coin" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🪙</span>
            <h3>Coin Flip</h3>
            <p>Simple heads or tails decision maker</p>
        </div>
    </a>

    <a href="/dice" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🎲</span>
            <h3>Dice Roller</h3>
            <p>Roll up to 6 dice at once</p>
        </div>
    </a>

    <a href="/number" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🔢</span>
            <h3>Number Generator</h3>
            <p>Generate random numbers</p>
        </div>
    </a>

    <a href="/teams" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">👥</span>
            <h3>Team Generator</h3>
            <p>Split lists into balanced random teams</p>
        </div>
    </a>

    <a href="/shuffle" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🔀</span>
            <h3>List Shuffler</h3>
            <p>Randomly shuffle any list of items</p>
        </div>
    </a>

    <a href="/password" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">&#x1F511;</span>
            <h3>Password Generator</h3>
            <p>Create strong 16-character passwords</p>
        </div>
    </a>

    <a href="/8ball" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">🔮</span>
            <h3>Magic 8 Ball</h3>
            <p>Instant decisions with classic answers</p>
        </div>
    </a>

    <a href="/datetime" class="tool-item">
        <div class="tool-content">
            <span class="tool-emoji">📅</span>
            <h3>Date & Time Picker</h3>
            <p>Random dates/times with exclusions</p>
        </div>
    </a>

</div>
