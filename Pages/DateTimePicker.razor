@page "/datetime"
@using System.Text.Json
@using RandomizerTools.ViewModels
@using RandomizerTools.Services
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime

<PageTitle>Random Date & Time - RandomizerTools</PageTitle>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-white" style="font-family: 'Fredoka', sans-serif;">Random Date & Time</h1>
        <p class="text-white-50 mb-0">Pick random dates (and times) with exclusions</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-7">
            <div class="card glass-card p-4 mb-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Start date</label>
                        <input type="date" class="form-control custom-input" @bind="_viewModel.StartDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">End date</label>
                        <input type="date" class="form-control custom-input" @bind="_viewModel.EndDate" />
                    </div>
                </div>

                <div class="form-check form-switch custom-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="timeSwitch" @bind="_viewModel.IncludeTime" @bind:after="OnOptionsChanged">
                    <label class="form-check-label text-white" for="timeSwitch">Include time range</label>
                </div>

                @if (_viewModel.IncludeTime)
                {
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">Start time</label>
                            <input type="time" class="form-control custom-input" step="60" @bind="_viewModel.StartTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-50 small">End time</label>
                            <input type="time" class="form-control custom-input" step="60" @bind="_viewModel.EndTime" />
                        </div>
                    </div>
                }

                <div class="row g-3 mt-3 align-items-center">
                    <div class="col-md-6">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="weekendSwitch" @bind="_viewModel.ExcludeWeekends">
                            <label class="form-check-label text-white" for="weekendSwitch">Exclude weekends</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Results</label>
                        <input type="number" min="1" max="10" class="form-control custom-input" @bind="_viewModel.ResultCount" />
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label text-white-50 small">Dates to exclude (comma or newline)</label>
                    <textarea class="form-control custom-textarea" rows="2" placeholder="2025-12-24, 2025-12-25" @bind="excludeInput"></textarea>
                    <div class="text-white-50 small mt-1">Invalid dates are ignored automatically.</div>
                </div>
            </div>

            <div class="card glass-card p-4">
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                    <button class="btn spin-btn" @onclick="Generate">Generate</button>
                    @if (_viewModel.Results.Count > 0)
                    {
                        <button class="btn btn-outline-light btn-sm" @onclick="CopyFirst">Copy latest</button>
                    }
                </div>

                @if (_viewModel.Results.Count == 0)
                {
                    <div class="text-white-50 fst-italic">No results yet.</div>
                }
                else
                {
                    <div class="results-grid">
                        @foreach (var dt in _viewModel.Results)
                        {
                            <div class="result-card">
                                <div class="result-date">@dt.ToString("yyyy-MM-dd")</div>
                                @if (_viewModel.IncludeTime)
                                {
                                    <div class="result-time">@dt.ToString("HH:mm")</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card glass-card p-4 history-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-white mb-0">History</h5>
                    @if (history.Count > 0)
                    {
                        <button class="btn btn-outline-light btn-sm" @onclick="ClearHistory">Clear</button>
                    }
                </div>
                @if (history.Count == 0)
                {
                    <div class="text-white-50 small fst-italic">No history yet</div>
                }
                else
                {
                    <ul class="list-unstyled mb-0 history-list">
                        @foreach (var dt in history)
                        {
                            <li class="history-item">@FormatDate(dt)</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private DateTimePickerViewModel _viewModel = null!;
    private string excludeInput = string.Empty;
    private List<DateTime> history = new();
    private const string StorageKey = "datetime_picker_state";

    // Initialize view model
    protected override void OnInitialized()
    {
        _viewModel = new DateTimePickerViewModel(RandomizerService);
    }

    // Load persisted state
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadState();
            StateHasChanged();
        }
    }

    // Generate new results
    private async Task Generate()
    {
        _viewModel.ExcludedDates = ParseExcludedDates();
        if (_viewModel.ResultCount < 1) _viewModel.ResultCount = 1;
        if (_viewModel.ResultCount > 10) _viewModel.ResultCount = 10;

        _viewModel.Generate();

        if (_viewModel.Results.Count > 0)
        {
            history.Insert(0, _viewModel.Results.First());
            if (history.Count > 15) history.RemoveAt(history.Count - 1);
        }

        await SaveState();
    }

    // Handle option changes
    private async Task OnOptionsChanged()
    {
        await SaveState();
    }

    // Copy latest result
    private async Task CopyFirst()
    {
        if (_viewModel.Results.Count == 0) return;
        var first = _viewModel.Results.First();
        await JSRuntime.InvokeVoidAsync("passwordHelper.copy", FormatDate(first));
    }

    // Clear history
    private async Task ClearHistory()
    {
        history.Clear();
        await SaveState();
    }

    private List<DateTime> ParseExcludedDates()
    {
        var list = new List<DateTime>();
        var parts = excludeInput.Split(new[] { ',', '\n', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var part in parts)
        {
            if (DateTime.TryParse(part, out var dt))
            {
                list.Add(dt.Date);
            }
        }
        return list;
    }

    private string FormatDate(DateTime dt)
    {
        return _viewModel.IncludeTime ? dt.ToString("yyyy-MM-dd HH:mm") : dt.ToString("yyyy-MM-dd");
    }

    private async Task SaveState()
    {
        var state = new PersistedState
        {
            startDate = _viewModel.StartDate,
            endDate = _viewModel.EndDate,
            startTime = _viewModel.StartTime.ToTimeSpan(),
            endTime = _viewModel.EndTime.ToTimeSpan(),
            includeTime = _viewModel.IncludeTime,
            excludeWeekends = _viewModel.ExcludeWeekends,
            excluded = ParseExcludedDates(),
            count = _viewModel.ResultCount,
            history = history
        };

        var json = JsonSerializer.Serialize(state);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
    }

    private async Task LoadState()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var state = JsonSerializer.Deserialize<PersistedState>(json);
                if (state != null)
                {
                    _viewModel.RestoreState(state.startDate, state.endDate, state.startTime, state.endTime, state.includeTime, state.excludeWeekends, state.excluded ?? new List<DateTime>(), state.count);
                    history = state.history ?? new List<DateTime>();
                    excludeInput = state.excluded != null && state.excluded.Count > 0
                        ? string.Join("\n", state.excluded.Select(d => d.ToString("yyyy-MM-dd")))
                        : string.Empty;
                }
            }
        }
        catch { }
    }

    private class PersistedState
    {
        public DateTime startDate { get; set; }
        public DateTime endDate { get; set; }
        public TimeSpan startTime { get; set; }
        public TimeSpan endTime { get; set; }
        public bool includeTime { get; set; }
        public bool excludeWeekends { get; set; }
        public List<DateTime>? excluded { get; set; }
        public int count { get; set; }
        public List<DateTime>? history { get; set; }
    }
}
