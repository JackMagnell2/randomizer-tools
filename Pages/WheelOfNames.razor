@page "/wheel"
@using RandomizerTools.ViewModels
@using RandomizerTools.Models
@using RandomizerTools.Services
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Wheel of Names - RandomizerTools</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3>Entries</h3>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Enter name..." 
                               @bind="currentInput" @onkeypress="HandleKeyPress" />
                        <button class="btn btn-primary" @onclick="AddName">Add</button>
                    </div>

                    <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
                        @if (_viewModel.Entries.Count == 0)
                        {
                            <div class="text-muted text-center p-3">Add names to start!</div>
                        }
                        @foreach (var entry in _viewModel.Entries)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                @entry.Name
                                <button class="btn btn-sm btn-outline-danger border-0" 
                                        @onclick="() => RemoveEntry(entry)">✕</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8 text-center">
            @if (_viewModel.Entries.Count > 0)
            {
                <div class="wheel-wrapper">
                    <canvas id="wheelCanvas"></canvas>
                </div>
                
                <button class="btn btn-success btn-lg mt-4 px-5 fw-bold shadow spin-btn" 
                        @onclick="SpinWheel" disabled="@isSpinning">
                    @if(isSpinning) { <span>Spinning...</span> } else { <span>SPIN</span> }
                </button>
            }
            else
            {
                <div class="alert alert-info mt-5">
                    <h4>Ready to spin?</h4>
                    <p>Add at least one name on the left to generate the wheel.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(winnerText))
            {
                <div class="winner-display mt-4 animate-pop">
                    <div class="text-muted text-uppercase small">Winner</div>
                    <div class="display-4 fw-bold text-primary">@winnerText</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private WheelOfNamesViewModel _viewModel = null!;
    private string currentInput = string.Empty;
    private bool isSpinning = false;
    private string winnerText = "";
    private DotNetObjectReference<WheelOfNames>? objRef;

    protected override void OnInitialized()
    {
        _viewModel = new WheelOfNamesViewModel(RandomizerService);
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender || _viewModel.Entries.Count > 0)
    {
        try 
        {
            var names = _viewModel.Entries.Select(e => e.Name).ToArray();
            await JSRuntime.InvokeVoidAsync("wheelHelper.init", "wheelCanvas", objRef);
            
            await JSRuntime.InvokeVoidAsync("wheelHelper.setNames", new object[] { names });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS Init Error: {ex.Message}");
        }
    }
}

    private async Task AddName()
{
    if (!string.IsNullOrWhiteSpace(currentInput))
    {
        _viewModel.AddEntry(currentInput);
        currentInput = string.Empty;
        
        var names = _viewModel.Entries.Select(e => e.Name).ToArray();

        await JSRuntime.InvokeVoidAsync("wheelHelper.setNames", new object[] { names });
    }
}

    private async Task RemoveEntry(WheelEntry entry)
{
    _viewModel.RemoveEntry(entry);
    var names = _viewModel.Entries.Select(e => e.Name).ToArray();

    await JSRuntime.InvokeVoidAsync("wheelHelper.setNames", new object[] { names });
}

    private async Task SpinWheel()
    {
        isSpinning = true;
        winnerText = "";
        // Trigger JS spin
        await JSRuntime.InvokeVoidAsync("wheelHelper.spin");
    }

    [JSInvokable]
    public void OnSpinFinished(string winnerName)
    {
        isSpinning = false;
        winnerText = winnerName;
        StateHasChanged(); // Refresh UI to show winner
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddName();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}