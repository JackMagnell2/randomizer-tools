@page "/wheel"
@using RandomizerTools.ViewModels
@using RandomizerTools.Models
@using RandomizerTools.Services
@using System.Text.Json
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Wheel of Names - RandomizerTools</PageTitle>

<div class="container py-4">
    <div class="row g-4 align-items-start">
        <div class="col-lg-4">
            <div class="card entries-card h-100">
                <div class="card-header border-bottom-0 pt-4 pb-0">
                    <h3 class="fw-bold text-dark mb-0">Entries</h3>
                    <small class="text-muted">@_viewModel.Entries.Count items</small>
                </div>
                <div class="card-body d-flex flex-column">
                    <div class="input-group modern-input-group mb-3">
                        <input type="text" class="form-control modern-input" 
                               placeholder="Add an entry..." 
                               @bind="currentInput" 
                               @bind:event="oninput"
                               @onkeypress="HandleKeyPress" />
                        <button class="btn btn-primary btn-add" @onclick="AddName">
                            Add
                        </button>
                    </div>

                    <div class="entries-list flex-grow-1 overflow-auto pe-2" style="max-height: 50vh;">
                        @if (_viewModel.Entries.Count == 0)
                        {
                            <div class="text-center text-muted mt-5 opacity-50">
                                <span class="fs-1">📝</span>
                                <p class="mt-2 small">List is empty.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var entry in _viewModel.Entries)
                            {
                                <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-light rounded hover-shadow">
                                    <span class="fw-500 text-truncate pe-2">@entry.Name</span>
                                    <button class="btn btn-link text-danger p-0 text-decoration-none" @onclick="() => RemoveEntry(entry)">
                                        <small>✕</small>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="d-flex flex-column align-items-center justify-content-center h-100">
                
                <div class="wheel-wrapper">
                    <canvas id="wheelCanvas"></canvas>
                </div>
                
                <button class="btn btn-success spin-btn" @onclick="SpinWheel" disabled="@CanSpin">
                    @if(isSpinning) { <span>Spinning...</span> } else { <span>SPIN!</span> }
                </button>

                @if (showWinner)
                {
                    <div class="winner-result">
                        <div class="winner-label">Winner</div>
                        <div class="winner-name">@winnerText</div>
                        
                        <div class="winner-actions">
                            <button class="btn btn-remove-winner rounded-pill" @onclick="RemoveWinner">
                                Remove & Close
                            </button>
                            <button class="btn btn-primary rounded-pill px-4" @onclick="CloseWinner">
                                Keep & Close
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private WheelOfNamesViewModel _viewModel = null!;
    private string currentInput = string.Empty;
    private bool isSpinning = false;
    private bool showWinner = false;
    private string winnerText = "";
    private bool _isWheelInit = false; 
    private DotNetObjectReference<WheelOfNames>? objRef;
    private const string LocalStorageKey = "wheel_entries";

    // Checks if the wheel is allowed to spin
    private bool CanSpin => isSpinning || _viewModel.Entries.Count == 0;

    // Initializes view model and object reference
    protected override void OnInitialized()
    {
        _viewModel = new WheelOfNamesViewModel(RandomizerService);
        objRef = DotNetObjectReference.Create(this);
    }

    // Handles asynchronous initialization after render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadEntries();
            await InitWheel();
        }
    }

    // Initializes the JavaScript wheel interface
    private async Task InitWheel()
    {
        if (!_isWheelInit)
        {
            try 
            {
                await JSRuntime.InvokeVoidAsync("wheelHelper.init", "wheelCanvas", objRef);
                await UpdateWheel();
                _isWheelInit = true;
            }
            catch { }
        }
    }

    // Adds a new entry to the list
    private async Task AddName()
    {
        if (!string.IsNullOrWhiteSpace(currentInput))
        {
            _viewModel.AddEntry(currentInput);
            currentInput = string.Empty;
            await SaveEntries();
            await UpdateWheel();
        }
    }

    // Removes a specific entry from the list
    private async Task RemoveEntry(WheelEntry entry)
    {
        _viewModel.RemoveEntry(entry);
        await SaveEntries();
        await UpdateWheel();
    }

    // Removes the winner and closes the display
    private async Task RemoveWinner()
    {
        var winnerEntry = _viewModel.Entries.FirstOrDefault(e => e.Name == winnerText);
        if (winnerEntry != null)
        {
            _viewModel.RemoveEntry(winnerEntry);
            showWinner = false;
            await SaveEntries();
            await UpdateWheel();
        }
    }

    // Closes the winner display without removing
    private void CloseWinner()
    {
        showWinner = false;
    }

    // Updates the wheel visualization with current data
    private async Task UpdateWheel()
    {
        var names = _viewModel.Entries.Select(e => e.Name).ToArray();
        await JSRuntime.InvokeVoidAsync("wheelHelper.setNames", new object[] { names });
    }

    // Initiates the spinning animation
    private async Task SpinWheel()
    {
        if (_viewModel.Entries.Count == 0) return;
        isSpinning = true;
        showWinner = false;
        await JSRuntime.InvokeVoidAsync("wheelHelper.spin");
    }

    // Callback invoked when spinning completes
    [JSInvokable]
    public void OnSpinFinished(string winnerName)
    {
        isSpinning = false;
        winnerText = winnerName;
        showWinner = true;
        StateHasChanged();
    }

    // Handles keyboard input for adding entries
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddName();
    }

    // Saves current entries to local storage
    private async Task SaveEntries()
    {
        var json = JsonSerializer.Serialize(_viewModel.Entries);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
    }

    // Loads entries from local storage
    private async Task LoadEntries()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", LocalStorageKey);
        if (!string.IsNullOrEmpty(json))
        {
            try 
            {
                var loadedEntries = JsonSerializer.Deserialize<List<WheelEntry>>(json);
                if (loadedEntries != null)
                {
                    _viewModel.Entries = loadedEntries;
                    StateHasChanged(); 
                }
            }
            catch { }
        }
    }

    // Disposes the object reference
    public void Dispose()
    {
        objRef?.Dispose();
    }
}