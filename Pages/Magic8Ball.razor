@page "/8ball"
@using System.Text.Json
@using RandomizerTools.ViewModels
@using RandomizerTools.Services
@inject RandomizerService RandomizerService
@inject IJSRuntime JSRuntime

<PageTitle>Magic 8 Ball - RandomizerTools</PageTitle>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-white" style="font-family: 'Fredoka', sans-serif;">Magic 8 Ball</h1>
        <p class="text-white-50 mb-0">Ask anything and get an instant answer</p>
    </div>

    <div class="row g-4 justify-content-center align-items-start">
        <div class="col-lg-6">
            <div class="card glass-card p-4 text-center">
                <div class="ball-wrapper mx-auto mb-4">
                    <div id="magicBall" class="eight-ball">
                        <div class="eight-ball-inner">
                            <div class="eight-ball-answer">@_viewModel.CurrentAnswer</div>
                        </div>
                    </div>
                </div>

                <button class="btn spin-btn w-100" @onclick="AskQuestion" disabled="@isAsking">
                    @if (isAsking) { <span>Shaking...</span> } else { <span>Ask</span> }
                </button>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card glass-card p-4 mb-3">
                <h5 class="text-white mb-3">Answer options</h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-white-50 small">Bias</label>
                        <select class="form-select custom-select" @bind="selectedBias">
                            <option value="balanced">Balanced</option>
                            <option value="positive">Positive</option>
                            <option value="neutral">Neutral</option>
                            <option value="negative">Negative</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" id="soundSwitch" @bind="playSound">
                            <label class="form-check-label text-white" for="soundSwitch">Sound on shake</label>
                        </div>
                    </div>
                </div>

                <div class="form-check form-switch custom-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="customSwitch" @bind="useCustom">
                    <label class="form-check-label text-white" for="customSwitch">Use my own answers</label>
                </div>

                <textarea class="form-control custom-textarea mt-2" rows="3" placeholder="Add custom answers separated by commas or new lines" @bind="customInput"></textarea>
                <div class="text-white-50 small mt-1">The 8 ball uses your list when enabled; otherwise the classic answers are used.</div>
            </div>

            <div class="card glass-card p-4 history-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-white mb-0">Recent answers</h5>
                    @if (_viewModel.History.Count > 0)
                    {
                        <button class="btn btn-outline-light btn-sm" @onclick="ClearHistory">Clear</button>
                    }
                </div>
                @if (_viewModel.History.Count == 0)
                {
                    <div class="text-white-50 small fst-italic">No questions yet</div>
                }
                else
                {
                    <ul class="list-unstyled mb-0 history-list">
                        @foreach (var answer in _viewModel.History)
                        {
                            <li class="history-item">@answer</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private Magic8BallViewModel _viewModel = null!;
    private bool isAsking = false;
    private bool useCustom = false;
    private bool playSound = true;
    private string customInput = string.Empty;
    private string selectedBias = "balanced";
    private const string HistoryKey = "magic8_history";

    // Initializes view model
    protected override void OnInitialized()
    {
        _viewModel = new Magic8BallViewModel(RandomizerService);
    }

    // Loads history after first render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadHistory();
            try { await JSRuntime.InvokeVoidAsync("magic8Helper.init", "magicBall"); } catch { }
            StateHasChanged();
        }
    }

    // Handles ask action
    private async Task AskQuestion()
    {
        isAsking = true;
        var customList = ParseCustomInput();
        _viewModel.Ask(useCustom, customList, selectedBias);
        await SaveState();

        try
        {
            await JSRuntime.InvokeVoidAsync("magic8Helper.shake", "magicBall", playSound);
        }
        catch { }

        isAsking = false;
    }

    // Persists state to local storage
    private async Task SaveState()
    {
        var payload = new
        {
            history = _viewModel.History,
            custom = ParseCustomInput(),
            useCustom,
            playSound,
            bias = selectedBias
        };
        var json = JsonSerializer.Serialize(payload);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", HistoryKey, json);
    }

    // Restores state from local storage
    private async Task LoadHistory()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", HistoryKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var state = JsonSerializer.Deserialize<StoredState>(json);
                if (state != null)
                {
                    _viewModel.RestoreHistory(state.history ?? new List<string>());
                    useCustom = state.useCustom;
                    playSound = state.playSound;
                    selectedBias = state.bias ?? "balanced";
                    customInput = state.custom != null ? string.Join("\n", state.custom) : string.Empty;
                }
            }
        }
        catch { }
    }

    // Clears stored history
    private async Task ClearHistory()
    {
        _viewModel.ClearHistory();
        await SaveState();
    }

    // Splits custom input into answers
    private List<string> ParseCustomInput()
    {
        var parts = customInput.Split(new[] { ',', '\n', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return new List<string>(parts);
    }

    private class StoredState
    {
        public List<string>? history { get; set; }
        public List<string>? custom { get; set; }
        public bool useCustom { get; set; }
        public bool playSound { get; set; }
        public string? bias { get; set; }
    }
}
